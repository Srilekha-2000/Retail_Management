<div class="flex justify-center items-start min-h-screen bg-gradient-to-r from-gray-100 to-gray-200 p-6 pt-20">
    <div class="w-full max-w-6xl bg-white shadow-lg rounded-lg border border-gray-300 p-6">
        <!-- Header -->
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Assign Activity</h1>
        </div>

        <div class="overflow-x-auto">
            <!-- Retailors Created by the Current User -->
            <h2 class="text-xl font-semibold text-blue-700 mb-4">Your Created Retailors</h2>
            <table class="w-full bg-white border border-gray-300 rounded-lg shadow-sm mb-8">
                <thead>
                    <tr class="bg-blue-700 text-white">
                        <th class="py-3 px-4 text-left">SL.NO.</th>
                        <th class="py-3 px-4 text-left">Retailor Shop Name</th>
                        <th class="py-3 px-4 text-left">District</th>
                        <th class="py-3 px-4 text-left">Zone</th>
                        <th class="py-3 px-4 text-left">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% @retailors.where(user_id: current_user.id).each_with_index do |retailor, index| %>
                    <tr class="border-b border-gray-300 hover:bg-gray-100">
                        <td class="py-3 px-4 font-medium text-gray-700"><%= index + 1 %></td>
                        <td class="py-3 px-4 text-gray-700 font-semibold"><%= retailor.shop_name %></td>
                        <td class="py-3 px-4 text-gray-600"><%= retailor.district&.name %></td>
                        <td class="py-3 px-4 text-gray-600"><%= retailor.zone&.name %></td>
                        <td class="py-3 px-4">
                            <%= link_to "Visit", edit_visit_retailor_path(retailor), class: "bg-yellow-500 text-white px-4 py-2 rounded-md shadow hover:bg-yellow-600 transition duration-300" %>
                        </td>
                    </tr>
                    <% end %>
                </tbody>
            </table>

            <!-- Retailors Assigned by Admin -->
            <h2 class="text-xl font-semibold text-red-700 mb-4">Retailors Assigned by Admin</h2>
            <table class="w-full bg-white border border-gray-300 rounded-lg shadow-sm">
                <thead>
                    <tr class="bg-red-700 text-white">
                        <th class="py-3 px-4 text-left">SL.NO.</th>
                        <th class="py-3 px-4 text-left">Retailor Name</th>
                        <th class="py-3 px-4 text-left">District</th>
                        <th class="py-3 px-4 text-left">Zone</th>
                        <th class="py-3 px-4 text-left">Assign Task</th>
                        <th class="py-3 px-4 text-left">Visiting Time</th>
                        <th class="py-3 px-4 text-left">Order Status</th>
                        <th class="py-3 px-4 text-left">Leave Time</th>
                        <th class="py-3 px-4 text-left">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% @visits.each_with_index do |visit, index| %>
                    <% visit.retailor_visits.each do |retailor_visit| %>
                    <tr class="border-b border-gray-300 hover:bg-gray-100">
                        <td class="py-3 px-4 font-medium text-gray-700"><%= index + 1 %></td>
                        <td class="py-3 px-4 text-gray-700 font-semibold"><%= retailor_visit.retailor.shop_name %></td>
                        <td class="py-3 px-4 text-gray-600"><%= retailor_visit.retailor.district&.name %></td>
                        <td class="py-3 px-4 text-gray-600"><%= retailor_visit.retailor.zone&.name %></td>
                        <td class="py-3 px-4 text-gray-600 italic"><%= retailor_visit.activity %></td>
                        <td class="py-3 px-4 text-gray-700 font-semibold">
                            <%= retailor_visit.visiting_time&.in_time_zone("Asia/Kolkata")&.strftime("%d-%m-%Y %I:%M %p") %>
                        </td>
                        <td class="py-3 px-4">
                            <% if visit.order_status == "Placed Order" %>
                            <span class="text-green-700 bg-green-100 border border-green-400 px-3 py-1 rounded-md shadow-sm">
                                Placed Order
                            </span>
                            <% else %>
                            <span class="text-red-700 bg-red-100 border border-red-400 px-3 py-1 rounded-md shadow-sm">
                                <%= visit.order_status %>
                            </span>
                            <% end %>
                        </td>
                        <td class="py-3 px-4 text-gray-600 italic">
                            <%= visit.leave_time&.in_time_zone("Asia/Kolkata")&.strftime("%d-%m-%Y %I:%M %p") %>
                        </td>
                        <td class="py-3 px-4">
                            <% if visit.leave_time.blank? %>
                            <%= link_to "New Visit", edit_visit_retailor_path(retailor_visit.retailor),
                                            class: "bg-yellow-500 text-white px-5 py-2 rounded-lg border border-yellow-700 shadow-lg text-sm font-semibold transition duration-300 ease-in-out transform hover:scale-105 hover:shadow-xl flex items-center justify-center gap-2" %>
                            <% else %>
                            <button class="bg-gray-300 text-gray-500 cursor-not-allowed px-5 py-2 rounded-lg border border-gray-400 shadow text-sm font-semibold flex items-center justify-center gap-2" disabled>
                                New Visit
                            </button>
                            <% end %>
                        </td>
                    </tr>
                    <% end %>
                    <% end %>
                </tbody>
            </table>
        </div>
    </div>
</div>