<div class="flex items-center justify-center min-h-screen bg-gray-100">
    <%= form_with(model: @retailor_visit, local: true) do |form| %>
    <div class="space-y-4 w-full max-w-2xl p-8 bg-white shadow-lg rounded-lg">
        <!-- Retailor Select -->
        <div>
            <%= form.label :retailor_id, class: "block text-gray-700 font-semibold" %>
            <%= form.select :retailor_id, @retailors.collect { |r| [r.shop_name, r.id] }, { prompt: "Select Retailor", multiple: true }, class: "mt-1 block w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <!-- Visit Select -->
        <div>
            <%= form.label :visit_id, class: "block text-gray-700 font-semibold" %>
            <%= form.select :visit_id, @visits.collect { |v| [v.date_of_time, v.id] }, { prompt: "Select Visit" }, class: "mt-1 block w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <!-- Status Input -->
        <div>
            <%= form.label :status, class: "block text-gray-700 font-semibold" %>
            <%= form.text_field :status, class: "mt-1 block w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <!-- Activity Input -->
        <div>
            <%= form.label :activity, class: "block text-gray-700 font-semibold" %>
            <%= form.text_area :activity, class: "mt-1 block w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <!-- User Select -->
        <div>
            <%= form.label :user_id, class: "block text-gray-700 font-semibold" %>
            <%= form.select :user_id, @users.collect { |u| [u.email, u.id] }, { prompt: "Select User" }, class: "mt-1 block w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <!-- District Select -->
        <div>
            <%= form.label :district_id, class: "block text-gray-700 font-semibold" %>
            <%= form.select :district_id, @districts.collect { |d| [d.name, d.id] }, { prompt: "Select District" }, class: "mt-1 block w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <!-- Zone Select -->
        <div>
            <%= form.label :zone_id, class: "block text-gray-700 font-semibold" %>
            <%= form.select :zone_id, @zones.collect { |z| [z.name, z.id] }, { prompt: "Select Zone" }, class: "mt-1 block w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <!-- Submit Button -->
        <div class="mt-4">
            <%= form.submit "Submit", class: "w-full py-2 px-4 bg-indigo-600 text-white rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 hover:bg-indigo-700" %>
        </div>
    </div>
    <% end %>
</div>