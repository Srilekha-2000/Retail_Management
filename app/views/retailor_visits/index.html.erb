<div class="flex justify-center items-center min-h-screen bg-gray-50">
    <div class="overflow-x-auto shadow-lg rounded-lg border border-gray-300 w-full max-w-4xl">
        <h3 class="text-2xl font-semibold text-gray-800 mb-6 text-center">Assigned Retailor Visits</h3>

        <table class="min-w-full table-auto">
            <thead>
                <tr class="bg-gray-100 border-b">
                    <th class="px-6 py-3 text-left text-sm font-medium text-gray-700">Salesman</th>
                    <th class="px-6 py-3 text-left text-sm font-medium text-gray-700">District</th>
                    <th class="px-6 py-3 text-left text-sm font-medium text-gray-700">Zone</th>
                    <th class="px-6 py-3 text-left text-sm font-medium text-gray-700">Retailor</th>
                    <th class="px-6 py-3 text-left text-sm font-medium text-gray-700">Visit Date</th>
                </tr>
            </thead>
            <tbody class="bg-white">
                <% @retailor_visits.each do |visit| %>
                <tr class="border-b hover:bg-gray-50">
                    <!-- Salesman Name -->
                    <td class="px-6 py-4 text-sm font-medium text-gray-700">
                        <%= visit.user.user_detail.first_name %> <%= visit.user.user_detail.last_name %>
                    </td>
                    <!-- District -->
                    <td class="px-6 py-4 text-sm text-gray-500">
                        <%= visit.district&.name || "Not Assigned" %>
                    </td>
                    <!-- Zone -->
                    <td class="px-6 py-4 text-sm text-gray-500">
                        <%= visit.zone&.name || "Not Assigned" %>
                    </td>
                    <!-- Retailor Name -->
                    <td class="px-6 py-4 text-sm text-gray-500">
                        <%= visit.retailor&.shop_name || "Not Assigned" %>
                    </td>
                    <!-- Visit Date -->
                    <td class="px-6 py-4 text-sm text-gray-500">
                        <%= retailor_visit.visiting_time %>
                    </td>
                </tr>
                <% end %>
            </tbody>
        </table>
    </div>
</div>