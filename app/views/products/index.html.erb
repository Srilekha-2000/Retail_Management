<div class="min-h-screen flex items-start justify-center bg-gray-100">
    <div class="max-w-6xl w-full bg-white shadow-md rounded-lg p-6 mt-12">
        <h2 class="text-3xl font-semibold text-center text-gray-800 mb-8">Product List</h2>

        <!-- Add New Product Button -->
        <div class="text-center mb-6">
            <%= link_to 'Add New Product', new_product_path, class: 'bg-indigo-600 text-white px-8 py-3 rounded-full shadow-lg hover:bg-indigo-700 transition-all duration-300 transform hover:scale-105' %>
        </div>

        <div class="overflow-x-auto">
            <!-- Loading Spinner -->
            <% if @products.empty? %>
            <div class="flex justify-center py-8">
                <div class="animate-spin border-t-4 border-indigo-600 border-solid w-16 h-16 rounded-full"></div>
            </div>
            <% else %>
            <table class="min-w-full bg-white shadow-md rounded-lg overflow-hidden table-auto">
                <thead class="bg-gradient-to-r from-indigo-600 to-indigo-700 text-white">
                    <tr>
                        <th class="py-4 px-6 text-left text-sm font-semibold">Sl. No.</th>
                        <th class="py-4 px-6 text-left text-sm font-semibold">Name</th>
                        <th class="py-4 px-6 text-left text-sm font-semibold">Amount</th>
                        <th class="py-4 px-6 text-left text-sm font-semibold">Actions</th>
                    </tr>
                </thead>
                <%= form_with(url: products_path, method: :get, local: true) do |form| %>
                <div class="flex items-center space-x-3 mb-4">
                    <%= label_tag :search, "Search:", class: "text-sm text-gray-700" %>
                    <%= form.text_field :search, value: params[:search], placeholder: "Search Products", class: 'px-4 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-600' %>
                    <%= form.submit "Search", class: 'px-4 py-2 bg-indigo-600 text-white text-sm rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-600' %>
                </div>
                <% end %>

                <tbody>
                    <% @products.each_with_index do |product, index| %>
                    <tr class="<%= 'bg-gray-50' if index.even? %> border-b hover:bg-gray-100 transition duration-200">
                        <td class="py-4 px-6 text-gray-800 font-medium text-sm"><%= index + 1 %></td> <!-- Sl. No. -->
                        <td class="py-4 px-6 text-gray-700 text-sm"><%= product.name %></td>
                        <td class="py-4 px-6 text-gray-700 font-medium text-sm"><%= number_to_currency(product.amount, unit: "₹") %></td>
                        <td class="py-4 px-6 text-gray-700 text-sm">
                            <%= link_to 'View', product_path(product), class: 'text-indigo-600 hover:text-indigo-800' %> |
                            <%
=begin%>
                            <%= link_to 'Edit', edit_product_path(product), class: 'text-yellow-600 hover:text-yellow-800' %> |
                            <%= link_to 'Delete', product_path(product), method: :delete, data: { confirm: 'Are you sure?' }, class: 'text-red-600 hover:text-red-800' %>
                            <%
=end%>
                        </td>
                    </tr>
                    <% end %>
                </tbody>
            </table>
            <% end %>
        </div>
    </div>
</div>
<div class="mt-4">
    <%= render 'layouts/shared/paginator', paginator: @users %>
</div>