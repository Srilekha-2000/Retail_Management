<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Retail Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>

<body class="bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-white" style="background-image: url('<%= asset_path('images.jpeg') %>'); background-size: cover; background-position: center;">

    <div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden w-full max-w-3xl">
            <div class="flex flex-col xl:flex-row">
                <!-- Left Section -->
                <div class="flex-1 p-8 md:p-12 xl:w-1/2 bg-gray-50 dark:bg-gray-700">
                    <div class="text-center">
                        <a href="index.html">
                            <%= image_tag('logo/logo-dark.svg', alt: 'Logo', class: "mx-auto mb-6") %>
                        </a>
                        <p class="text-lg font-medium text-gray-700 dark:text-gray-300 mb-6">
                            A Quotation Retail Management System to manage product quotations for retail businesses.
                        </p>
                        <%= image_tag('illustration/illustration-03.svg', alt: 'illustration', class: "mx-auto mt-8") %>
                    </div>
                </div>

                <!-- Right Section: Form -->
                <div class="flex-1 p-8 md:p-12 xl:w-1/2">
                    <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Log In to Your Account</h2>

                    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
                    <div class="mb-6">
                        <%= f.label :email, "Enter your email", class: "block text-sm font-medium text-gray-900 dark:text-gray-300" %>
                        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full p-4 border border-gray-300 rounded-lg bg-transparent text-gray-900 dark:bg-gray-800 dark:text-white dark:border-gray-600 focus:ring-2 focus:ring-primary dark:focus:ring-primary focus:outline-none" %>
                        <% if f.object.errors[:email].any? %>
                        <div class="text-red-500 text-sm mt-1">
                            <%= f.object.errors[:email].join(", ") %>
                        </div>
                        <% end %>
                    </div>

                    <div class="mb-6">
                        <%= f.label :password, "Enter your password", class: "block text-sm font-medium text-gray-900 dark:text-gray-300" %>
                        <%= f.password_field :password, autocomplete: "current-password", class: "w-full p-4 border border-gray-300 rounded-lg bg-transparent text-gray-900 dark:bg-gray-800 dark:text-white dark:border-gray-600 focus:ring-2 focus:ring-primary dark:focus:ring-primary focus:outline-none" %>
                    </div>

                    <div class="mb-6">
                        <%= f.submit "Log In", class: "w-full py-4 px-6 text-white bg-blue-500 rounded-lg cursor-pointer hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-400 transition duration-300" %>
                    </div>

                    <% end %>

                    <div class="text-center mt-4">
                        <p class="text-sm text-gray-600 dark:text-gray-300">Don't have an account?
                            <%= link_to 'Sign up here', new_user_registration_path, class: 'text-blue-500 hover:underline' %>
                        </p>
                    </div>

                </div>
            </div>
        </div>
    </div>

</body>

</html>