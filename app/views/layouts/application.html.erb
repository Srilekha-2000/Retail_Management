<!DOCTYPE html>
<html lang="en">

<head>
    <title>RetailManagement</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload" %>
</head>

<body class="flex flex-col min-h-screen bg-gray-100">

    <% if user_signed_in? %>
    <div class="flex flex-1">
        <!-- Sidebar -->
        <div class="bg-gray-800 w-64 p-4" id="sidebarFullComponent">
            <%= render 'layouts/shared/sidebar' %>
        </div>


        <div class="hidden bg-gray-800" id="sidebarIcon">
            <button id="sidebarToggleButton" class="block p-2 rounded-full bg-gray-800 border border-gray-600 text-white" onclick="openSidebar()">
                <svg class="fill-current" width="20" height="18" xmlns="http://www.w3.org/2000/svg" transform="scale(-1,1)" viewBox="0 0 20 18">
                    <path d="M19 8.175H2.98748L9.36248 1.6875C9.69998 1.35 9.69998 0.825 9.36248 0.4875C9.02498 0.15 8.49998 0.15 8.16248 0.4875L0.399976 8.3625C0.0624756 8.7 0.0624756 9.225 0.399976 9.5625L8.16248 17.4375C8.31248 17.5875 8.53748 17.7 8.76248 17.7C8.98748 17.7 9.17498 17.625 9.36248 17.475C9.69998 17.1375 9.69998 16.6125 9.36248 16.275L3.02498 9.8625H19C19.45 9.8625 19.7875 9.8625 20.1125 9.175C20.1125 8.8125 19.7875 8.4875 19.45 8.4875C19.1125 8.4875 18.7875 8.175 19 8.175Z" />
                </svg>
            </button>
            <ul class="flex flex-col space-y-2 ml-0 mt-6">
                <% if current_user.present? && current_user.roles.any? { |role| role.name == 'Admin' } %>
                <li>
                    <a href="<%= roles_path %>" class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-white rounded-md bg-gray-800 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500">
                        <svg class="w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H16M8 12H16M8 8H16M4 4V20M20 4V20" />
                        </svg>
                        
                    </a>
                </li>
                <li>
                    <a href="<%= new_add_user_path %>" class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-white rounded-md bg-gray-800 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500">
                        <svg class="w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                        </svg>
                        
                    </a>
                </li>
                <li>
                    <a href="<%= add_users_path %>" class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-white rounded-md bg-gray-800 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500">
                        <svg class="w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2h-5v2zM17 16h5v-2h-5v2zM17 12h5v-2h-5v2zM5 4h3v1H5V4zM5 7h3v1H5V7zM5 10h3v1H5v-1zM5 13h3v1H5v-1zM5 16h3v1H5v-1z" />
                        </svg>
                        
                    </a>
                </li>
                <li>
                    <a href="<%=dynamic_select_zones_path%>" class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-white rounded-md bg-gray-800 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500">
                        <svg class="w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                        </svg>
                        
                    </a>
                </li>
                <li>
                    <a href="<%=catagories_path%>" class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-white rounded-md bg-gray-800 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500">
                        <svg class="w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                        </svg>
                        
                    </a>
                </li>
                <li>
                    <a href="<%= products_path %>" class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-white rounded-md bg-gray-800 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500">
                        <svg class="w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2h-5v2zM17 16h5v-2h-5v2zM17 12h5v-2h-5v2zM5 4h3v1H5V4zM5 7h3v1H5V7zM5 10h3v1H5v-1zM5 13h3v1H5v-1zM5 16h3v1H5v-1z" />
                        </svg>
                        
                    </a>
                </li>

                <li>
                    <a href="<%= new_retailor_path %>" class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-white rounded-md bg-gray-800 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500">
                        <svg class="w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                        </svg>
                        
                    </a>
                </li>



                <li>
                    <a href="<%=retailor_users_path%>" class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-white rounded-md bg-gray-800 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500">
                        <svg class="w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                        </svg>
                        
                    </a>
                </li>


                <li>
                    <a href="<%=visits_path%>" class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-white rounded-md bg-gray-800 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500">
                        <svg class="w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                        </svg>
                        
                    </a>
                </li>


                <li>
                    <a href="<%=orders_path%>" class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-white rounded-md bg-gray-800 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500">
                        <svg class="w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                        </svg>
                        
                    </a>
                </li>


                <% elsif current_user.present? && current_user.user_detail.role.name == 'Salesman' %>


                <a href="<%= new_retailor_path %>" class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-white rounded-md bg-gray-800 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500">
                    <svg class="w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                    </svg>
                    
                </a>
                </li>
                <li>
                    <a href="<%= retailors_path %>" class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-white rounded-md bg-gray-800 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500">
                        <svg class="w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16 12H8m8 0H8m4-8v16" />
                        </svg>
                        
                    </a>
                </li>
                <% end %>
            </ul>
        </div>


        <!-- Main Content Wrapper -->
        <div class="flex flex-col w-full">
            <!-- Navbar -->
            <div class="flex-1 flex flex-col">
                <%= render 'layouts/shared/navbar' %>
                <%= render 'layouts/shared/flash_messages' %>

                <!-- Yield main content -->
                <%= yield %>
            </div>

            <!-- Footer -->
            <div>
                <%= render 'layouts/shared/footer' %>
            </div>
        </div>
    </div>
    <% else %>
    <!-- User is not signed in -->
    <div class="flex flex-col flex-grow bg-cover bg-center h-screen" style="background-image: url('/retail-management-system.jpg');">

        <%= notice %>
        <%= alert %>
        <%= yield %>

    </div>
    <% end %>

</body>

<script>
    // Function to close the flash message
    function openSidebar() {
        const sidebar = document.getElementById("sidebarFullComponent");
        sidebar.classList.remove("hidden");

        const sidebarIcon = document.getElementById("sidebarIcon");
        sidebarIcon.classList.add("hidden");
    }
</script>

</html>