<!-- app/views/categories/index.html.erb -->
<div class="flex justify-center items-center min-h-screen bg-gray-50 py-8">
    <div class="w-full max-w-4xl bg-white p-6 md:p-8 rounded-lg shadow-lg">
        <h1 class="text-3xl font-semibold mb-6 text-center text-gray-800">Categories</h1>

        <!-- New Category Link -->
        <div class="mb-4 text-center">
            <%= link_to 'New Category', new_catagory_path, class: "inline-block text-white bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-md transition-all duration-200" %>
        </div>

        <!-- Table Section -->
        <div class="overflow-x-auto">
            <table class="min-w-full table-auto bg-white shadow-md rounded-lg border-separate border-spacing-0">
                <thead>
                    <tr class="bg-gray-100 border-b">
                        <th class="px-6 py-3 text-left text-sm font-medium text-gray-700">Sl No.</th>
                        <th class="px-6 py-3 text-left text-sm font-medium text-gray-700">Name</th>
                        <th class="px-6 py-3 text-left text-sm font-medium text-gray-700">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% @catagories.each_with_index do |catagory,index| %>
                    <tr class="border-b hover:bg-gray-50">
                        <td class="px-6 py-4 text-sm text-gray-800 font-medium"><%=index+1%></td>
                        <td class="px-6 py-4 text-sm text-gray-800 font-medium"><%= catagory.name %></td>
                        <td class="px-6 py-4 text-sm text-gray-800">
                            <%= link_to 'Show', catagory_path(catagory), class: "text-blue-600 hover:text-blue-800 px-2 py-1 inline-block transition-colors duration-200" %>
                            |
                            <%= link_to 'Edit', edit_catagory_path(catagory), class: "text-yellow-600 hover:text-yellow-800 px-2 py-1 inline-block transition-colors duration-200" %>
                            |
                            <%= link_to 'Delete', catagory_path(catagory), method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-600 hover:text-red-800 px-2 py-1 inline-block transition-colors duration-200" %>
                        </td>
                    </tr>
                    <% end %>
                </tbody>
            </table>
        </div>
    </div>
</div>