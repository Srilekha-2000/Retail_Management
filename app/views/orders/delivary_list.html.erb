<div class="flex items-center justify-center min-h-screen">
    <div class="w-full max-w-5xl px-4">
        <h2 class="text-xl font-bold text-gray-800 mb-6 text-center">Delivery List</h2>

        <div class="overflow-x-auto bg-white p-6 shadow-md rounded-lg">
            <table class="min-w-full border border-gray-300">
                <thead class="bg-gray-100 border-b">
                    <tr class="text-gray-700 font-semibold text-center">
                        <th class="px-6 py-3">Sl No.</th>
                        <th class="px-6 py-3">Order ID</th>
                        <th class="px-6 py-3">Retailor Name</th>
                        <th class="px-6 py-3">Status</th>
                        <th class="px-6 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% @orders.each_with_index do |order,index| %>
                    <tr class="border-b hover:bg-gray-50 text-center">
                        <td class="px-6 py-4 text-gray-800"><%= index+1%></td>
                        <td class="px-6 py-4 text-gray-800"><%= order.unique_code %></td>
                        <td class="px-6 py-4 text-gray-800"><%= order&.retailor&.shop_name %></td>
                        <td class="px-6 py-4 text-gray-800"><%= order&.status %></td>
                        <td class="px-6 py-4">
                            <%= link_to "View", order_path(order), class: "px-4 py-2 text-white bg-blue-500 hover:bg-blue-700 rounded-lg text-sm" %>
                        </td>
                    </tr>
                    <% end %>
                </tbody>
            </table>
        </div>
    </div>
</div>