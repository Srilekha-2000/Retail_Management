<div class="min-h-screen flex flex-col">


    <!-- Main Content (Centered) -->
    <div class="flex-grow flex justify-center items-center h-full p-6">
        <div class="w-full max-w-4xl">
            <h1 class="text-2xl font-bold text-center mb-6">My Orders</h1>

            <div class="overflow-x-auto bg-white p-6 shadow-lg rounded-lg">
                <table class="min-w-full border border-gray-300">
                    <thead>
                        <tr class="bg-gray-800 text-white text-left">
                            <th class="py-3 px-6">Sl No.</th>
                            <th class="py-3 px-6">Order ID</th>
                            <th class="py-3 px-6">Retailor</th>
                            <th class="py-3 px-6">Status</th>

                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% @orders.each_with_index do |order,index| %>
                        <tr class="hover:bg-gray-100">
                            <td class="py-3 px-6"><%= index+1%></td>
                            <td class="py-3 px-6"><%= order.unique_code %></td>
                            <td class="py-3 px-6"><%= order.retailor.shop_name if order.retailor %></td>
                            <td class="py-3 px-6 font-semibold text-blue-600"><%= order.status.humanize %></td>

                        </tr>
                        <% end %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>