<div class="flex items-center justify-center min-h-screen bg-gray-100">
    <div class="bg-white p-6 rounded-lg shadow-lg w-full max-w-md">
        <h2 class="text-xl font-semibold text-center mb-4">Edit Order Status</h2>

        <%= form_with model: @order, url: order_path(@order), method: :patch, local: true do |f| %>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Order Status</label>
            <%= f.select :status, Order.statuses.keys.map { |status| [status.humanize, status] }, selected: @order.status, class: "border px-3 py-2 rounded w-full focus:ring focus:ring-blue-300" %>
        </div>

        <div class="flex justify-between">
            <%= f.submit "Update Status", class: "px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 cursor-pointer transition-all" %>
            <%= link_to "Cancel", orders_path, class: "px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600 transition-all" %>
        </div>
        <% end %>
    </div>
</div>