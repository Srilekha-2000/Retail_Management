<!-- app/views/add_users/new.html.erb -->

<!-- Main container with fixed navbar -->
<div class="flex flex-col min-h-screen bg-gray-100">
    <!-- Fixed Navbar -->
    <header class="bg-gray-800 text-white shadow-md sticky top-0 z-4">
        <%= render 'layouts/shared/navbar' %>
    </header>

    <!-- Main Content (Starts below the navbar) -->
    <main class="flex-1 p-6 mt-16">
        <!-- Add margin-top to account for navbar height -->
        <h1 class="text-2xl font-bold mb-6 text-center">Create New User</h1>

        <%= form_for @user, url: add_users_path, html: { class: "w-full max-w-lg mx-auto bg-white p-8 rounded-lg shadow-md" } do |f| %>
        <!-- Email Field -->
        <div class="mb-4">
            <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
            <%= f.email_field :email, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
        </div>

        <!-- Password Field -->
        <div class="mb-4">
            <%= f.label :password, class: "block text-sm font-medium text-gray-700" %>
            <%= f.password_field :password, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
        </div>

        <!-- Password Confirmation Field -->
        <div class="mb-4">
            <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700" %>
            <%= f.password_field :password_confirmation, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
        </div>

        <!-- User Details Section -->
        <h3 class="text-lg font-semibold mt-6 mb-4">User Details</h3>
        <%= f.fields_for :user_detail do |ud| %>
        <!-- First Name Field -->
        <div class="mb-4">
            <%= ud.label :first_name, class: "block text-sm font-medium text-gray-700" %>
            <%= ud.text_field :first_name, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
        </div>

        <!-- Last Name Field -->
        <div class="mb-4">
            <%= ud.label :last_name, class: "block text-sm font-medium text-gray-700" %>
            <%= ud.text_field :last_name, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
        </div>
        
        <!-- Role Selection Field -->
        <div class="mb-4">
            <%= ud.label :role_id, "Role", class: "block text-sm font-medium text-gray-700" %>
            <%= ud.collection_select :role_id, Role.all, :id, :name, { prompt: "Select Role" }, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
        </div>

        <!-- District Field -->
        <div class="mb-4">
            <%= ud.label :district_id, "District", class: "block text-sm font-medium text-gray-700" %>
            <%= ud.collection_select :district_id, District.all.order(:name), :id, :name, { prompt: "Select District" }, class: 'mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm', id: "user_district_id" %>
        </div>

        <!-- Zone Field -->
        <%
=begin%>
 <div class="mb-4">
            <%= ud.label :zone_id, "Zone", class: "block text-sm font-medium text-gray-700" %>
            <%= ud.collection_select :zone_id, Zone.all.order(:name), :id, :name, { prompt: "Select Zone" }, class: 'mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm', id: "user_zone_id" %>
        </div> 
<%
=end%>

        <% end %>

        <!-- Submit Button -->
        <div class="flex justify-center mt-6">
            <%= f.submit "Create User", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded-md shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>
        <% end %>
    </main>
</div>