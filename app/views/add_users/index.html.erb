<!-- app/views/add_users/index.html.erb -->

<!-- Main container with fixed navbar -->
<div class="flex flex-col min-h-screen bg-gray-100">
    <!-- Fixed Navbar -->
    <header class="bg-gray-800 text-white shadow-md sticky top-0 z-4">
        <%= render 'layouts/shared/navbar' %>
    </header>

    <!-- Main Content (Starts below the navbar) -->
    <main class="flex-1 p-6 mt-16">
        <!-- Card container with responsive styling -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="bg-white shadow-lg rounded-lg p-6">
                <!-- Card header -->
                <h1 class="text-3xl font-extrabold mb-8 text-center text-gray-800">User List</h1>

                <!-- Table container with responsive styling -->
                <div class="overflow-x-auto bg-white shadow-md rounded-lg mb-6">
                    <table class="min-w-full table-auto border-separate border-spacing-0">
                        <thead class="bg-indigo-600 text-white">
                            <tr>
                                <th class="px-6 py-3 text-left text-sm font-semibold border-b border-gray-300">Sl No.</th>
                                <th class="px-6 py-3 text-left text-sm font-semibold border-b border-gray-300">Email</th>
                                <th class="px-6 py-3 text-left text-sm font-semibold border-b border-gray-300">First Name</th>
                                <th class="px-6 py-3 text-left text-sm font-semibold border-b border-gray-300">Last Name</th>
                                <th class="px-6 py-3 text-left text-sm font-semibold border-b border-gray-300">Role</th>
                                <th class="px-6 py-3 text-left text-sm font-semibold border-b border-gray-300">Actions</th>
                            </tr>
                        </thead>

                        <!-- Search Form -->
                        <%= form_with(url: add_users_path, method: :get, local: true) do |f| %>
                        <div class="flex items-center space-x-3 mb-4">
                            <%= label_tag :search, "Search:", class: "text-sm text-gray-700" %>
                            <%= text_field_tag :search, params[:search], class: "border border-gray-300 rounded-md p-1 text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
                            <%= submit_tag "Search", class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm rounded-md py-1 px-4 focus:outline-none" %>
                        </div>
                        <% end %>


                        <!-- Table Body -->
                        <tbody class="text-gray-700">
                            <% @users.each_with_index do |user, index| %>
                            <tr class="hover:bg-gray-50 transition-colors duration-300">
                                <td class="px-6 py-4 text-sm border-b border-gray-200"><%= index + 1 %></td>
                                <td class="px-6 py-4 text-sm border-b border-gray-200"><%= user.email %></td>
                                <td class="px-6 py-4 text-sm border-b border-gray-200"><%= user.user_detail&.first_name || 'N/A' %></td>
                                <td class="px-6 py-4 text-sm border-b border-gray-200"><%= user.user_detail&.last_name || 'N/A' %></td>
                                <td class="px-6 py-4 text-sm border-b border-gray-200"><%= user.user_detail&.role&.name || 'N/A' %></td>
                                <td class="px-6 py-4 text-sm border-b border-gray-200">
                                    <!-- Edit and Delete actions for the user -->
                                    <%= link_to 'Edit', edit_add_user_path(user), class: "text-indigo-600 hover:text-indigo-700 mr-2" %>|
                                    <%= link_to 'Delete', add_user_path(user), method: :delete, data: { confirm: 'Are you sure you want to delete this user?' }, class: "text-red-600 hover:text-red-700 ml-2" %>
                                </td>
                            </tr>
                            <% end %>
                        </tbody>
                    </table>
                </div>

                <!-- Action buttons -->
                <div class="mt-6 flex justify-center space-x-4">
                    <%= link_to 'Create New User', new_add_user_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white py-2 px-6 rounded-md transition duration-200 ease-in-out shadow-lg" %>
                    <!-- Additional buttons can be added here if needed -->
                </div>
            </div>
        </div>
    </main>
</div>

<!-- Pagination -->
<div class="mt-4">
    <%= render 'layouts/shared/paginator', paginator: @users %>
</div>