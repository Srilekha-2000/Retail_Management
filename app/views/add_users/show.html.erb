<h1 class="text-2xl font-bold mb-6 text-center">User Details</h1>

<div class="max-w-lg mx-auto bg-white p-8 rounded-lg shadow-md">
    <h3 class="text-xl font-semibold">User Information</h3>

    <div class="mb-4">
        <strong>Email:</strong> <%= @user.email %>
    </div>

    <div class="mb-4">
        <strong>First Name:</strong> <%= @user.user_detail.first_name %>
    </div>

    <div class="mb-4">
        <strong>Last Name:</strong> <%= @user.user_detail.last_name %>
    </div>

    <div class="mb-4">
        <strong>Role:</strong> <%= @user.user_detail&.role&.name %>
    </div>


    <%= link_to 'Edit', edit_add_user_path(@user), class: "text-indigo-500 hover:text-indigo-600 font-semibold transition duration-300 ease-in-out" %> |
    <%= link_to 'Back to Users List', add_users_path, class: "text-indigo-500 hover:text-indigo-600 font-semibold transition duration-300 ease-in-out" %>
</div>